# Copy to .env and adjust. All variables are optional; defaults suit local development.
PASSREADY_ENVIRONMENT=dev
# Resolver domain printed into the QR code (GS1 Digital Link root). Must stay stable for the
# lifetime of the labels (ESPR Art. 10, prEN 18221 persistence).
PASSREADY_RESOLVER_BASE_URL=https://id.passready.example
# Optional: browsers (Accept: text/html) are redirected to this landing page instead of JSON.
# PASSREADY_LANDING_PAGE_BASE_URL=https://pass.passready.example
# MVP stand-ins for real authentication (OAuth2 / JWT per prEN 18239):
PASSREADY_BRAND_API_KEY=demo-brand-key
PASSREADY_AUTHORITY_API_KEY=demo-authority-key
PASSREADY_SUPPLIER_TOKEN_TTL_DAYS=30
PASSREADY_SEED_DEMO_DATA=true
# When set, the PostgreSQL/JSONB repository replaces the in-memory store (not yet implemented):
# PASSREADY_DATABASE_URL=postgresql+asyncpg://passready:passready@localhost:5434/passready
# Browser origins allowed to call the API directly (JSON list). The Vite dev server proxies
# instead, so this only matters when the frontend is hosted on its own domain.
# PASSREADY_CORS_ORIGINS=["https://pass.passready.example"]
# Product images: local folder and the public URL under which it is served.
PASSREADY_MEDIA_DIR=media
PASSREADY_MEDIA_BASE_URL=http://localhost:8000/media
# Frontend origin for supplier links in reminders, and when a pending supplier counts as due.
PASSREADY_PORTAL_BASE_URL=http://localhost:5173
PASSREADY_REMINDER_INTERVAL_DAYS=7
